# 清流运行环境模板（复制为 .env，或服务器 /etc/qingliu/qingliu.env）
# 真实密码、VAULT_KEY、service secret 只放 .secrets/ 或密码管理器，不提交。

MYSQL_DSN=qingliu:CHANGE_ME@tcp(127.0.0.1:3306)/qingliu?charset=utf8mb4
PUBLIC_ORIGIN=https://qingliu.example.com
# 生成：openssl rand -hex 32；与加密备份分开保存，丢失后旧文件无法解密。
VAULT_KEY=REPLACE_WITH_64_HEX_CHARACTERS

DATA_DIR=/var/lib/qingliu
STATIC_DIR=/opt/qingliu/frontend/dist
PDF_FONT=/opt/qingliu/fonts/NotoSansSC.ttf
LISTEN_ADDR=127.0.0.1:8787
GOMEMLIMIT=512MiB
GOMAXPROCS=2

WORKBENCH_BASE_URL=https://worker.example.com
WORKBENCH_SERVICE_CLIENT=qingliu
WORKBENCH_SERVICE_SECRET=CHANGE_ME

# 没有工作台时的本地应急登录（1 = 允许）
QINGLIU_ALLOW_LOCAL_LOGIN=

# 可选留存策略
# AUDIT_RETENTION_DAYS=90
# AUDIT_LOGIN_RETENTION_DAYS=30
# COLD_DATA_RETENTION_DAYS=30
