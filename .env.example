# Copy to .env; do not send real credentials with the source package.
# Use a dedicated database/user within the team's EXISTING MySQL 8.0+ / 8.4.
# MySQL in a host: host.docker.internal:3306 (must accept Docker bridge connection).
# MySQL in another container: join that network and use its service name instead.
MYSQL_DSN=qingliu:CHANGE_ME@tcp(host.docker.internal:3306)/qingliu?charset=utf8mb4
PUBLIC_ORIGIN=https://qingliu.example.com
# Generate: openssl rand -hex 32 ; save separately with encrypted backups.
VAULT_KEY=REPLACE_WITH_64_HEX_CHARACTERS
